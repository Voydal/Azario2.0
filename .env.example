# Copy to .env for Docker Compose: cp .env.example .env
# Compose reads .env automatically; cargo run does not.
# For host processes: set -a; source .env; set +a

# PostgreSQL initialization and Compose connection credentials.
# Match an existing database volume: changing these values does not update
# users/passwords/databases in an already initialized volume.
# Use URL-safe user/password/database values: Compose builds a connection URI.
POSTGRES_DB=parking
POSTGRES_USER=parking
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Published host ports (container ports remain fixed).
WEB_PORT=80
API_PORT=8080
NATS_PORT=4222
NATS_MONITOR_PORT=8222

# Browser-facing addresses. Update both if you change the published ports.
# The frontend origin must exactly match the URL used in the browser (CORS).
FRONTEND_ORIGIN=http://localhost
VITE_PARKING_API_BASE_URL=http://localhost:8080

# Backend Google Geocoding / Routes key. Empty disables Google-backed search.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_HTTP_TIMEOUT_MS=3000
PARKING_SEARCH_RADIUS_M=800
PARKING_CANDIDATE_LIMIT=25
PARKING_SEARCH_TIMEOUT_MS=15000
# All timeouts are milliseconds; numeric settings must be positive.
# PARKING_CANDIDATE_LIMIT must not exceed 625.

# Public browser key for Maps JavaScript API; embedded in the frontend bundle.
# VITE_* changes require: docker compose up -d --build web
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAP_ID=DEMO_MAP_ID

# API / worker database pool; API readiness and operation timeouts.
DATABASE_MAX_CONNECTIONS=10
DATABASE_ACQUIRE_TIMEOUT_MS=2000
DATABASE_CHECK_TIMEOUT_MS=1500
DATABASE_OPERATION_TIMEOUT_MS=5000

# Shared service logging. LOG_FORMAT accepts pretty or json.
LOG_FORMAT=json
RUST_LOG=info

# Host-only connections for cargo run / integration tests / camera-simulator.
# Compose builds DATABASE_URL from POSTGRES_* using postgres:5432 internally,
# and uses nats://nats:4222 internally; it does not use these host URLs.
# Host access requires a non-internal network on the corresponding service.
# For camera-simulator, attach NATS to nats-access as described in README.md.
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/${POSTGRES_DB}
NATS_URL=nats://127.0.0.1:${NATS_PORT}
# Host-only API bind address. Compose always binds the API to 0.0.0.0:3000.
API_BIND_ADDRESS=0.0.0.0:8080
# For host frontend development with Vite, use FRONTEND_ORIGIN=http://localhost:5173.

# Optional Compose edge profile: docker compose --profile edge up -d --build
# Prepare config/edge-camera.toml from config/edge-camera.example.toml.
# These are host directories mounted read-only into the edge container.
EDGE_ARTIFACTS_DIR=./artifacts
EDGE_ONNX_RUNTIME_DIR=./artifacts/onnxruntime
# EDGE_ARTIFACTS_DIR must contain parking-detector-v1.onnx and parking-camera.mp4.
# EDGE_ONNX_RUNTIME_DIR must contain a compatible Linux libonnxruntime.so and
# its companion libraries. ROI, camera ID, thresholds, sampling, and SQLite
# state path belong in config/edge-camera.toml, not environment variables.

# Host-only edge / evaluator paths. Compose supplies its own container paths.
PARKING_MODEL_PATH=./artifacts/parking-detector-v1.onnx
PARKING_VIDEO_PATH=./artifacts/parking-camera.mp4
ORT_DYLIB_PATH=./artifacts/onnxruntime/libonnxruntime.so
# For the host edge agent, PARKING_VIDEO_PATH is applied only when
# PARKING_MODEL_PATH is also set. These files are optional for camera-simulator.

# Optional API build metadata for a host Cargo build (not runtime configuration).
# Set before compiling; the current Dockerfile does not forward this variable.
# PARKING_GIT_SHA=your-commit-sha
